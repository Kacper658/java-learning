
public class Main {

	public static void main(String[] args) {
		int diagonal = 0;
		char at = '$';
		drawRhombus(diagonal, at);
	}
	private static void drawRhombus(int diagonal, char chr) {
		if (diagonal<1) return;
		int width = 1;
		for (int i = 1; i<=diagonal+1; i++) {
			for (int j = width; j<=diagonal/2+1; j++) {
				System.out.print(" ");
			}
			for (int j = width*2; j>0; j--) {
				System.out.print(chr);
			}
			System.out.println("");
			if (i<=diagonal/2) {
				width++;
			}
			else {
				width--;
			}
		}
	}
