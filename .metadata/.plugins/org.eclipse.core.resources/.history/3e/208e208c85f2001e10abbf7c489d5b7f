    public Mixed(T value) {
        this.value = value;
    }

    public T getValue() {
        return value;
    }

    public void setValue(T value) {
        this.value = value;
    }
    
    public String type() {
    	try {
    	value.equals((String)value);
    	}
    	catch (java.lang.ClassCastException e) {
//    		try {
//    			Typetester t = new Typetester();
//        		return t.getType(value);
//    		}
//    		catch ()
    		return "";
    	}
    	return "String";
    }
    

    @Override
    public String toString() {
        return "Mixed{" +
                "value=" + value +
                '}';
    }
}
